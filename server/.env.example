# Server configuration — copy to server/.env and edit.

# Port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# MongoDB connection string. Leave blank to use the local JSON fallback store
# (server/data/db.json) — handy for a quick demo, not for production.
MONGODB_URI=mongodb://127.0.0.1:27017/aurelia

# Long random string used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Session lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Origin allowed to call the API with credentials
CLIENT_ORIGIN=http://localhost:5173

# Initial admin account, created automatically if no users exist.
# CHANGE THE PASSWORD before deploying anywhere public.
ADMIN_EMAIL=admin@aureliadental.studio
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Practice Manager

# Set to false to skip loading the demo content JSON into the database.
SEED_DEMO_CONTENT=true
